{
  "id": "reservations",
  "name": "Reservations",
  "version": "3.0.39",
  "description": "Table and resource reservations, with configurable time slots and blocked dates.",
  "agent": {
    "description": "Manages table and resource reservations: create, update and track bookings, configure time slots and blocked dates, and handle the waitlist.",
    "keywords": [
      "reservation",
      "booking",
      "table",
      "timeslot",
      "waitlist",
      "availability",
      "blocked date"
    ]
  },
  "depends_on": [
    "tables",
    "customers"
  ],
  "permissions": [
    "reservations.view_reservation",
    "reservations.add_reservation",
    "reservations.change_reservation",
    "reservations.delete_reservation",
    "reservations.view_timeslot",
    "reservations.change_timeslot",
    "reservations.view_blockeddate",
    "reservations.change_blockeddate",
    "reservations.view_waitlistentry",
    "reservations.change_waitlistentry",
    "reservations.view_settings",
    "reservations.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "reservations.view_reservation",
      "reservations.add_reservation",
      "reservations.change_reservation",
      "reservations.view_timeslot",
      "reservations.change_timeslot",
      "reservations.view_blockeddate",
      "reservations.change_blockeddate",
      "reservations.view_waitlistentry",
      "reservations.change_waitlistentry",
      "reservations.view_settings",
      "reservations.manage_settings"
    ],
    "employee": [
      "reservations.view_reservation",
      "reservations.add_reservation",
      "reservations.view_timeslot",
      "reservations.view_blockeddate",
      "reservations.view_waitlistentry",
      "reservations.view_settings"
    ]
  },
  "navigation": [
    {
      "id": "list",
      "label": "Reservations",
      "icon": "calendar-outline",
      "component": "erp-reservations-list"
    },
    {
      "id": "waitlist",
      "label": "Waitlist",
      "icon": "people-outline",
      "component": "erp-reservations-waitlist"
    },
    {
      "id": "availability",
      "label": "Availability",
      "icon": "time-outline",
      "component": "erp-reservations-availability"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_gate.sql",
      "migrations/postgres/003_gate_reason.sql",
      {
        "file": "migrations/postgres/004_named_gate_constraints.sql",
        "kind": "contract",
        "since": "3.0.26"
      }
    ]
  },
  "queries": {
    "reservations.reservations.list": {
      "permission": "reservations.view_reservation",
      "sql": "queries/reservations_list.sql",
      "list": {
        "search": [
          "customer_id",
          "guest_name",
          "guest_phone",
          "guest_email"
        ],
        "sort": [
          "id",
          "customer_id",
          "guest_name",
          "guest_phone",
          "guest_email",
          "date",
          "time",
          "party_size",
          "duration_minutes",
          "table_id",
          "status",
          "notes",
          "starts_at"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "customer_id": {
            "op": "eq"
          },
          "guest_name": {
            "op": "like"
          },
          "guest_phone": {
            "op": "like"
          },
          "guest_email": {
            "op": "like"
          },
          "date": {
            "op": "range"
          },
          "time": {
            "op": "like"
          },
          "party_size": {
            "op": "range"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "table_id": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists reservations with their status, customer, table and date/time"
      }
    },
    "reservations.reservations.get": {
      "permission": "reservations.view_reservation",
      "sql": "queries/reservation_get.sql",
      "ai": {
        "description": "Retrieves the full detail of a reservation by its identifier"
      }
    },
    "reservations.timeslots.list": {
      "permission": "reservations.view_timeslot",
      "sql": "queries/timeslots_list.sql",
      "list": {
        "sort": [
          "id",
          "day_of_week",
          "start_time",
          "end_time",
          "max_reservations",
          "is_active"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "day_of_week": {
            "op": "eq"
          },
          "start_time": {
            "op": "like"
          },
          "end_time": {
            "op": "like"
          },
          "max_reservations": {
            "op": "range"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists available time slots by day of the week"
      }
    },
    "reservations.slots.count_for": {
      "permission": "reservations.view_reservation",
      "sql": "queries/slots_count_for.sql",
      "ai": {
        "description": "Counts live reservations per time slot for a date (reserved vs max, seats available) — the read side of the overbooking gate; optional time narrows to one slot"
      }
    },
    "reservations.day.summary": {
      "permission": "reservations.view_reservation",
      "sql": "queries/day_summary.sql",
      "ai": {
        "description": "Figures of one service day: live reservations and covers (sum of party sizes) for a date"
      }
    },
    "reservations.blocked_dates.on_date": {
      "permission": "reservations.view_blockeddate",
      "sql": "queries/blocked_dates_on_date.sql",
      "ai": {
        "description": "Loads the blocked dates (holidays or closures) covering one exact date, used by the create handler to refuse a booking on a blocked day authoritatively (runtime reads)"
      }
    },
    "reservations.blocked_dates.list": {
      "permission": "reservations.view_blockeddate",
      "sql": "queries/blocked_dates_list.sql",
      "list": {
        "sort": [
          "id",
          "date",
          "reason",
          "is_full_day",
          "blocked_from",
          "blocked_until"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "date": {
            "op": "range"
          },
          "reason": {
            "op": "like"
          },
          "is_full_day": {
            "op": "eq"
          },
          "blocked_from": {
            "op": "eq"
          },
          "blocked_until": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists dates blocked as holidays or business closures"
      }
    },
    "reservations.waitlist.list": {
      "permission": "reservations.view_waitlistentry",
      "sql": "queries/waitlist_list.sql",
      "list": {
        "search": [
          "customer_id",
          "guest_name",
          "guest_phone",
          "guest_email"
        ],
        "sort": [
          "id",
          "customer_id",
          "guest_name",
          "guest_phone",
          "guest_email",
          "date",
          "preferred_time",
          "party_size",
          "notes",
          "is_contacted",
          "is_converted",
          "reservation_id"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "customer_id": {
            "op": "eq"
          },
          "guest_name": {
            "op": "like"
          },
          "guest_phone": {
            "op": "like"
          },
          "guest_email": {
            "op": "like"
          },
          "date": {
            "op": "range"
          },
          "preferred_time": {
            "op": "like"
          },
          "party_size": {
            "op": "range"
          },
          "notes": {
            "op": "like"
          },
          "is_contacted": {
            "op": "eq"
          },
          "is_converted": {
            "op": "eq"
          },
          "reservation_id": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists waitlist entries pending table assignment"
      }
    },
    "reservations.settings.get": {
      "permission": "reservations.view_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the current reservations module settings for the hub"
      }
    }
  },
  "commands": {
    "reservations.reservations.create": {
      "permission": "reservations.add_reservation",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_reservation"
      },
      "schema": "schemas/reservation_create.json",
      "reads": [
        {
          "query": "reservations.settings.get",
          "required": true
        },
        {
          "query": "reservations.slots.count_for",
          "params": {
            "date": "payload.date"
          },
          "required": true
        },
        {
          "query": "reservations.blocked_dates.on_date",
          "params": {
            "date": "payload.date"
          },
          "required": true
        }
      ],
      "ai": {
        "description": "Creates a new reservation for a customer at a table and time slot (validates availability, blocked dates, slot capacity and advance window)"
      }
    },
    "reservations._create_gated": {
      "permission": "reservations.add_reservation",
      "sql": [
        "commands/_create_gated_insert.sql",
        "commands/_create_gated_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "reservations.reservations.update": {
      "permission": "reservations.change_reservation",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_reservation"
      },
      "schema": "schemas/reservation_update.json",
      "reads": [
        {
          "query": "reservations.reservations.get",
          "params": {
            "reservation_id": "payload.reservation_id"
          }
        }
      ],
      "emit": [
        "reservations.reservation.updated"
      ],
      "ai": {
        "description": "Updates the details of an existing reservation (date, time, party size, guest contact). Staff can edit any reservation; an edit on behalf of the guest (channel=customer) must carry that guest's `customer_id`, is refused when the reservation belongs to somebody else, and cannot touch the table assignment or the restaurant's internal notes. The change still has to pass the availability gate (party-size limits, advance window, blocked days, slot capacity)."
      }
    },
    "reservations._apply_update": {
      "permission": "reservations.change_reservation",
      "sql": [
        "commands/reservation_update.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "reservations.update_rejected",
        "message": "That change is not available: the slot is full, the day is blocked, the party size is out of range, or the new time falls outside the booking window."
      }
    },
    "reservations.reservations.set_status": {
      "permission": "reservations.change_reservation",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_status"
      },
      "schema": "schemas/reservation_set_status.json",
      "reads": [
        {
          "query": "reservations.reservations.get",
          "params": {
            "reservation_id": "payload.reservation_id"
          }
        }
      ],
      "ai": {
        "description": "Changes the status of a reservation validating the state machine (confirmed, seated, completed, cancelled, no_show). Staff can change any reservation; a change on behalf of the guest (channel=customer) must carry that guest's `customer_id` and is refused when the reservation belongs to somebody else."
      }
    },
    "reservations._apply_status": {
      "permission": "reservations.change_reservation",
      "sql": [
        "commands/_apply_status_update.sql",
        "commands/_apply_status_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "reservations.reservations.delete": {
      "permission": "reservations.delete_reservation",
      "transaction": true,
      "sql": [
        "commands/reservation_delete.sql"
      ],
      "schema": "schemas/reservation_delete.json",
      "emit": [
        "reservations.reservation.deleted"
      ],
      "ai": {
        "description": "Permanently deletes a reservation from the system (destructive)"
      }
    },
    "reservations.timeslots.create": {
      "permission": "reservations.change_timeslot",
      "transaction": true,
      "sql": [
        "commands/timeslot_create.sql"
      ],
      "schema": "schemas/timeslot_create.json",
      "emit": [
        "reservations.timeslot.created"
      ],
      "ai": {
        "description": "Creates a new available time slot for reservations"
      }
    },
    "reservations.timeslots.delete": {
      "permission": "reservations.change_timeslot",
      "transaction": true,
      "sql": [
        "commands/timeslot_delete.sql"
      ],
      "schema": "schemas/timeslot_delete.json",
      "emit": [
        "reservations.timeslot.deleted"
      ],
      "ai": {
        "description": "Deletes a time slot so it is no longer available for new reservations (destructive)"
      }
    },
    "reservations.blocked_dates.create": {
      "permission": "reservations.change_blockeddate",
      "transaction": true,
      "sql": [
        "commands/blocked_date_create.sql"
      ],
      "schema": "schemas/blocked_date_create.json",
      "emit": [
        "reservations.blocked_date.created"
      ],
      "ai": {
        "description": "Blocks a date as a holiday or closure, preventing new reservations on that day"
      }
    },
    "reservations.blocked_dates.delete": {
      "permission": "reservations.change_blockeddate",
      "transaction": true,
      "sql": [
        "commands/blocked_date_delete.sql"
      ],
      "schema": "schemas/blocked_date_delete.json",
      "emit": [
        "reservations.blocked_date.deleted"
      ],
      "ai": {
        "description": "Removes the block from a date to allow reservations again on that day (destructive)"
      }
    },
    "reservations.waitlist.create": {
      "permission": "reservations.change_waitlistentry",
      "transaction": true,
      "sql": [
        "commands/waitlist_create.sql"
      ],
      "schema": "schemas/waitlist_create.json",
      "emit": [
        "reservations.waitlist.created"
      ],
      "ai": {
        "description": "Adds a customer to the waitlist when no tables are available"
      }
    },
    "reservations.waitlist.update": {
      "permission": "reservations.change_waitlistentry",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "waitlist_update"
      },
      "schema": "schemas/waitlist_update.json",
      "emit": [
        "reservations.waitlist.updated"
      ],
      "ai": {
        "description": "Updates a waitlist entry; setting is_converted atomically promotes it into a reservation"
      }
    },
    "reservations._waitlist_update": {
      "permission": "reservations.change_waitlistentry",
      "sql": [
        "commands/_waitlist_update.sql"
      ]
    },
    "reservations._waitlist_promote": {
      "permission": "reservations.change_waitlistentry",
      "sql": [
        "commands/_waitlist_promote_insert.sql",
        "commands/_waitlist_promote_link.sql",
        "commands/_waitlist_promote_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "reservations.waitlist.delete": {
      "permission": "reservations.change_waitlistentry",
      "transaction": true,
      "sql": [
        "commands/waitlist_delete.sql"
      ],
      "schema": "schemas/waitlist_delete.json",
      "emit": [
        "reservations.waitlist.deleted"
      ],
      "ai": {
        "description": "Removes an entry from the waitlist (destructive)"
      }
    },
    "reservations.settings.set_auto_confirm": {
      "permission": "reservations.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_set_auto_confirm.sql"
      ],
      "schema": "schemas/settings_set_auto_confirm.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "reservations.cannot_update_settings",
        "message": "The reservation settings could not be changed: this restaurant has no settings in use right now."
      },
      "emit": [
        "reservations.settings.updated"
      ],
      "ai": {
        "description": "Turns on or off whether a reservation the guest booked herself — online or through an automation such as WhatsApp — is created already confirmed. It changes that single setting and leaves every other reservations setting exactly as the restaurant left it."
      }
    },
    "reservations.settings.upsert": {
      "permission": "reservations.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "schema": "schemas/settings_upsert.json",
      "emit": [
        "reservations.settings.updated"
      ],
      "ai": {
        "description": "Saves or updates the reservations module settings for the hub"
      }
    },
    "reservations.reservations.release_unconfirmed": {
      "permission": "reservations.change_reservation",
      "transaction": true,
      "sql": [
        "commands/release_unconfirmed.sql"
      ],
      "emit": [
        "reservations.reservations.unconfirmed_released"
      ],
      "ai": {
        "description": "Releases pending reservations whose time has passed the no-show grace window (they were never confirmed): frees their slot capacity. Runs on a schedule; safe to run by hand"
      }
    },
    "reservations._on_customer_merged": {
      "permission": "reservations.change_reservation",
      "transaction": true,
      "sql": [
        "commands/customer_merge_reservations.sql",
        "commands/customer_merge_waitlist.sql"
      ]
    }
  },
  "events": {
    "listen": {
      "customer.merged": {
        "command": "reservations._on_customer_merged"
      }
    },
    "emits": [
      "reservations.blocked_date.created",
      "reservations.blocked_date.deleted",
      "reservations.reservation.created",
      "reservations.reservation.deleted",
      "reservations.reservation.status_changed",
      "reservations.reservation.updated",
      "reservations.reservations.unconfirmed_released",
      "reservations.settings.updated",
      "reservations.timeslot.created",
      "reservations.timeslot.deleted",
      "reservations.waitlist.created",
      "reservations.waitlist.deleted",
      "reservations.waitlist.updated"
    ]
  },
  "errors": {
    "reservations.cannot_update_settings": {},
    "reservations.customer_mismatch": {},
    "reservations.date_blocked": {},
    "reservations.email_required": {},
    "reservations.illegal_transition": {},
    "reservations.no_capacity": {},
    "reservations.no_service_day": {},
    "reservations.party_size_exceeded": {},
    "reservations.phone_required": {},
    "reservations.reads_unavailable": {},
    "reservations.staff_only_field": {},
    "reservations.update_rejected": {}
  },
  "scheduled_tasks": [
    {
      "name": "release_unconfirmed",
      "command": "reservations.reservations.release_unconfirmed",
      "cron": "*/15 * * * *",
      "catch_up": "collapse"
    }
  ],
  "ai_context": {
    "summary": "Module: Reservations (id: reservations). Table and resource reservations with time slots, blocked dates, waitlist and a per-hub settings record. Entities: reservation (guest booking with a status machine pending->confirmed->seated->completed, plus cancelled/no_show), timeslot (available windows per day_of_week), blocked_date (holidays/closures), waitlist entry (for full slots, convertible into a reservation), settings (party-size limits, advance booking window, auto-confirm, no-show window, reminders). Depends on the tables and customers modules. Reservations reference customer_id and table_id by contract (no FK). Non-CRUD logic implemented as a Tier 2 WASM handler (dist/handler.wasm): availability gate on create (party-size limits, blocked dates, active time slot, atomic slot capacity, advance-booking window) with a translated pre-check from preloaded reads (require_phone/require_email enforcement and refusal codes no_capacity/no_service_day/party_size_exceeded/date_blocked; the gate's abort row carries the reason since migration 003), status-transition state machine with authoritative timestamps, and atomic waitlist promotion (waitlist.update with is_converted creates and links the reservation in one transaction). Scheduled task release_unconfirmed (every 15 min) cancels pending reservations whose time passed the no-show grace window so they stop counting against the slot. Still pending: reminders and WhatsApp booking — see WASM-TODO.md.",
    "keywords": [
      "reservations",
      "tables",
      "time slots",
      "waitlist",
      "blocked dates"
    ]
  },
  "ui": {
    "entry": "dist/reservations.esm.js"
  }
}
