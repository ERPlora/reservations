{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reservations.blocked_dates.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["date"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "reason": { "type": "string", "default": "", "maxLength": 200 },
    "is_full_day": { "type": "boolean", "default": true },
    "blocked_from": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$", "default": null },
    "blocked_until": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$", "default": null }
  }
}
